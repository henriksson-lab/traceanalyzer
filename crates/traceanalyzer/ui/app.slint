import { ListView, VerticalBox, HorizontalBox, TabWidget, Button, StandardTableView, ScrollView, LineEdit, ComboBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Trace analyzer";
    icon: @image-url("../assets/window-icon.png");
    preferred-width: 1040px;
    preferred-height: 620px;
    min-width: 720px;
    min-height: 440px;

    in property <string> assay-title: "No file loaded";
    // Well list is a tree: row 0 is the file, rows 1.. are its wells. These
    // arrays are parallel over the *visible* rows (children are omitted when the
    // file node is collapsed).
    // Multi-file tree: rows span every open file (a file node followed by its
    // wells when expanded). All arrays are parallel over the visible rows.
    in property <[string]> tree-labels;
    in property <[bool]> tree-is-file;
    in property <[int]> tree-file-index;    // which file each row belongs to
    in property <[int]> tree-well-index;    // -1 for file rows, else well index in its file
    in property <[bool]> tree-file-expanded; // per-row: owning file's expanded state
    in property <[string]> tree-file-path;  // per-row: full path (file rows; "" on wells) for tooltip
    in property <[bool]> tree-selected;     // any-selected highlight, parallel to tree-labels
    in property <int> tree-primary-row: -1; // visible-row index of the active primary well
    in property <int> entry-count;          // active file's well count (keyboard-nav bound)
    // Rename: bound to the selected well's name; edited in the field, applied on Rename.
    in-out property <string> rename-text;
    in property <bool> can-rename: false;
    in property <bool> can-save: false;
    in property <string> sample-info: "";
    // Y-axis mode: options for the dropdown and the currently selected index.
    in property <[string]> y-mode-options;
    in property <int> y-mode-index: 0;
    in property <bool> normalize-on: false;
    in property <bool> marker-edit: false;
    in property <string> error-text: "";
    in property <image> plot-image;
    in-out property <int> current-index: 0;

    // Overview tab.
    in property <image> overview-image;
    in property <int> overview-image-width: 1600;
    in property <int> overview-image-height: 560;
    in property <bool> overview-shared-y: true;
    in property <bool> overview-gel: false;
    in property <bool> overview-show-ladders: false;
    // Selected tab index; set from Rust to jump to Detail on an overview click.
    in-out property <int> active-tab: 0;

    // Table tab: peak/region rows for the focused sample.
    in property <[[StandardListViewItem]]> table-rows;
    in-out property <int> table-current-row: -1;
    callback table-row-changed(int);

    // Keyboard selection within the active file: well index, ctrl-held, shift-held.
    callback select(int, bool, bool);
    // Mouse click on a visible tree row: row index, ctrl-held, shift-held.
    callback select-row(int, bool, bool);
    // Close the file owning a visible row (its [x] button).
    callback close-file(int);
    callback toggle-normalize();
    callback open-file();
    callback save-file();
    callback save-file-as();
    callback quit();
    callback about();
    // Expand/collapse the file node owning a visible row.
    callback toggle-file-expand(int);
    // Rename the primary-selected well to the given text (in-memory only).
    callback rename-well(string);
    // fractional (0..1) click position on the overview image.
    callback overview-click(float, float);
    callback toggle-overview-yscale();
    callback toggle-overview-gel();
    callback toggle-overview-ladders();
    // fractional-anchor x, y in 0..1; factor <1 zooms in, >1 zooms out
    callback zoom(float, float, float);
    // fractional pan delta (dx, dy) across the plot area
    callback pan(float, float);
    // fractional click position on the plot (select nearest peak)
    callback plot-click(float, float);
    // fractional pointer-down / pointer-up on the plot (marker grab/release)
    callback plot-press(float, float);
    callback plot-release();
    callback reset-view();
    // Select the Y-axis mode by index into y-mode-options.
    callback select-y-mode(int);
    callback toggle-marker-edit();
    callback reset-markers();

    property <float> plot-chart-left: 78.0 / 1600.0;
    property <float> plot-chart-right: 1588.0 / 1600.0;
    property <float> plot-chart-top: 12.0 / 560.0;
    property <float> plot-chart-bottom: 506.0 / 560.0;
    property <float> plot-chart-width: root.plot-chart-right - root.plot-chart-left;
    property <float> plot-chart-height: root.plot-chart-bottom - root.plot-chart-top;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => { root.open-file(); }
            }
            MenuItem {
                title: "Save";
                enabled: root.can-save;
                shortcut: @keys(Control + S);
                activated => { root.save-file(); }
            }
            MenuItem {
                title: "Save As…";
                enabled: root.can-save;
                shortcut: @keys(Control + Shift + S);
                activated => { root.save-file-as(); }
            }
            MenuSeparator {}
            MenuItem {
                title: "Quit";
                shortcut: @keys(Control + Q);
                activated => { root.quit(); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "About Trace analyzer";
                activated => { root.about(); }
            }
        }
    }

    VerticalBox {
        padding: 8px;
        spacing: 6px;

        if root.error-text != "": Text {
            text: root.error-text;
            color: #c0392b;
            font-size: 12px;
            wrap: word-wrap;
        }

        TabWidget {
            current-index <=> root.active-tab;
            Tab {
                title: "Detail";
                HorizontalBox {
                    spacing: 8px;

                    // --- well tree + rename ---
                    VerticalLayout {
                        width: 240px;
                        spacing: 4px;

                        Rectangle {
                            border-width: 1px;
                            border-color: #cccccc;
                            border-radius: 4px;
                            clip: true;
                            accessible-role: list;
                            accessible-label: "Wells";
                            forward-focus: well-list-focus;
                            well-list-focus := FocusScope {
                                key-pressed(event) => {
                                    if (event.text == Key.UpArrow && root.current-index > 0) {
                                        root.select(root.current-index - 1, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        return accept;
                                    } else if (event.text == Key.DownArrow && root.current-index + 1 < root.entry-count) {
                                        root.select(root.current-index + 1, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        return accept;
                                    } else if (event.text == Key.Home && root.entry-count > 0) {
                                        root.select(0, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        return accept;
                                    } else if (event.text == Key.End && root.entry-count > 0) {
                                        root.select(root.entry-count - 1, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        return accept;
                                    } else if (event.text == Key.Return || event.text == Key.Space) {
                                        root.select(root.current-index, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        return accept;
                                    }
                                    reject
                                }
                            }
                            ListView {
                                for row[i] in root.tree-labels: Rectangle {
                                    property <bool> is-file: i < root.tree-is-file.length && root.tree-is-file[i];
                                    height: 26px;
                                    // File row: no highlight. Well rows: primary is the
                                    // strongest, other selected rows a lighter tint.
                                    background: self.is-file
                                        ? transparent
                                        : (i == root.tree-primary-row
                                            ? #b7d5ff
                                            : (i < root.tree-selected.length && root.tree-selected[i] ? #dbeaff : transparent));
                                    accessible-role: list-item;
                                    accessible-label: row;
                                    // File row: hovering shows the full path verbatim
                                    // (custom content avoids markdown escaping the path).
                                    if (i < root.tree-is-file.length && root.tree-is-file[i] && i < root.tree-file-path.length && root.tree-file-path[i] != ""): Tooltip {
                                        Rectangle {
                                            background: #2b2b2b;
                                            border-radius: 4px;
                                            HorizontalLayout {
                                                padding: 6px;
                                                Text {
                                                    text: root.tree-file-path[i];
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                }
                                            }
                                        }
                                    }
                                    row-touch := TouchArea {
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.up
                                                && ev.button == PointerEventButton.left) {
                                                well-list-focus.focus();
                                                if (parent.is-file) {
                                                    root.toggle-file-expand(i);
                                                } else {
                                                    root.select-row(i,
                                                        ev.modifiers.control || ev.modifiers.meta,
                                                        ev.modifiers.shift);
                                                }
                                            }
                                        }
                                    }
                                    // Disclosure triangle (file rows), reflecting that file's state.
                                    Text {
                                        x: 6px;
                                        width: 14px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        color: #666666;
                                        visible: parent.is-file;
                                        text: (i < root.tree-file-expanded.length && root.tree-file-expanded[i]) ? "▾" : "▸";
                                    }
                                    // Label; wells are indented past the triangle column.
                                    Text {
                                        x: parent.is-file ? 22px : 34px;
                                        width: parent.width - self.x - (parent.is-file ? 28px : 6px);
                                        vertical-alignment: center;
                                        overflow: elide;
                                        font-weight: parent.is-file ? 700 : 400;
                                        text: row;
                                    }
                                    // Close [x] on file rows, revealed on hover.
                                    if (i < root.tree-is-file.length && root.tree-is-file[i]): Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        x: parent.width - self.width - 4px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4px;
                                        visible: row-touch.has-hover || close-touch.has-hover;
                                        background: close-touch.has-hover ? #d64545 : transparent;
                                        accessible-role: button;
                                        accessible-label: "Close file";
                                        Text {
                                            text: "✕";
                                            font-size: 12px;
                                            color: close-touch.has-hover ? #ffffff : #555555;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        close-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.close-file(i); }
                                        }
                                    }
                                }
                            }
                        }

                        // Rename the selected well (in-memory; persist via File → Save).
                        HorizontalLayout {
                            spacing: 4px;
                            rename-field := LineEdit {
                                enabled: root.can-rename;
                                placeholder-text: "well name";
                                text <=> root.rename-text;
                                accepted => { if (root.can-rename) { root.rename-well(self.text); } }
                            }
                            Button {
                                text: "Rename";
                                enabled: root.can-rename;
                                clicked => { root.rename-well(rename-field.text); }
                            }
                        }
                    }

                    // --- plot column ---
                    VerticalLayout {
                        spacing: 4px;

                        // toolbar
                        ScrollView {
                            min-height: 36px;
                            max-height: 42px;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                            // Use the content's *preferred* size, not its actual
                            // width/height: toolbar-row fills the Flickable viewport,
                            // so binding to `.width`/`.height` here would make
                            // viewport-width depend on itself (Slint "Recursion
                            // detected" panic at startup). preferred-* is intrinsic.
                            viewport-width: toolbar-row.preferred-width;
                            viewport-height: toolbar-row.preferred-height;
                            toolbar-row := HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "Reset view";
                                    clicked => { root.reset-view(); }
                                }
                                ComboBox {
                                    model: root.y-mode-options;
                                    current-index: root.y-mode-index;
                                    selected => { root.select-y-mode(self.current-index); }
                                }
                                Button {
                                    text: root.normalize-on ? "Normalized ✓" : "Normalize";
                                    clicked => { root.toggle-normalize(); }
                                }
                                Button {
                                    text: root.marker-edit ? "Scale to markers" : "Scale to markers ✓";
                                    clicked => { root.toggle-marker-edit(); }
                                }
                                if root.marker-edit: Button {
                                    text: "Reset markers";
                                    clicked => { root.reset-markers(); }
                                }
                            }
                        }

                        // plot image + interaction layer
                        Rectangle {
                            height: self.width * 560.0 / 1600.0;
                            border-width: 1px;
                            border-color: #cccccc;
                            border-radius: 4px;
                            clip: true;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                image-fit: fill;
                                source: root.plot-image;
                            }

                            plot-touch := TouchArea {
                                property <length> last-x;
                                property <length> last-y;
                                property <length> press-x;
                                property <length> press-y;
                                // Distinguish a click (select peak) from a pan drag.
                                property <bool> dragged;
                                property <bool> left-button-down;

                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down
                                        && ev.button == PointerEventButton.left) {
                                        self.last-x = self.mouse-x;
                                        self.last-y = self.mouse-y;
                                        self.press-x = self.mouse-x;
                                        self.press-y = self.mouse-y;
                                        self.dragged = false;
                                        self.left-button-down = true;
                                        root.plot-press(
                                            self.mouse-x / self.width,
                                            self.mouse-y / self.height);
                                    } else if (ev.kind == PointerEventKind.up && self.left-button-down) {
                                        if (!self.dragged) {
                                            root.plot-click(
                                                self.mouse-x / self.width,
                                                self.mouse-y / self.height);
                                        }
                                        root.plot-release();
                                        self.left-button-down = false;
                                    }
                                }
                                moved => {
                                    if (self.left-button-down) {
                                        if (!self.dragged
                                            && ((self.mouse-x - self.press-x > 4px)
                                                || (self.press-x - self.mouse-x > 4px)
                                                || (self.mouse-y - self.press-y > 4px)
                                                || (self.press-y - self.mouse-y > 4px))) {
                                            self.dragged = true;
                                        }
                                        if (self.dragged) {
                                            root.pan(
                                                (self.mouse-x - self.last-x) / (self.width * root.plot-chart-width),
                                                (self.mouse-y - self.last-y) / (self.height * root.plot-chart-height));
                                            self.last-x = self.mouse-x;
                                            self.last-y = self.mouse-y;
                                        }
                                    }
                                }
                                scroll-event(ev) => {
                                    root.zoom(
                                        self.mouse-x / self.width,
                                        self.mouse-y / self.height,
                                        ev.delta-y > 0 ? 0.85 : 1.18);
                                    accept
                                }
                            }
                        }

                        Text {
                            text: root.sample-info;
                            font-size: 12px;
                            color: #444444;
                            wrap: word-wrap;
                        }

                        // Peak/region table for the focused sample, below the plot.
                        StandardTableView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            columns: [
                                { title: "#", min-width: 40px },
                                { title: "size", min-width: 70px },
                                { title: "time (s)", min-width: 70px },
                                { title: "area", min-width: 70px },
                                { title: "height", min-width: 70px },
                                { title: "% total", min-width: 60px },
                                { title: "conc", min-width: 70px },
                                { title: "molarity", min-width: 70px },
                                { title: "note", min-width: 120px },
                            ];
                            rows: root.table-rows;
                            current-row <=> root.table-current-row;
                            current-row-changed(r) => { root.table-row-changed(r); }
                        }
                    }
                }
            }

            Tab {
                title: "Overview";
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: root.overview-gel ? "View: gel" : "View: traces";
                            clicked => { root.toggle-overview-gel(); }
                        }
                        Button {
                            text: root.overview-shared-y ? "Y-scale: shared" : "Y-scale: per-plot";
                            enabled: !root.overview-gel;
                            clicked => { root.toggle-overview-yscale(); }
                        }
                        Button {
                            text: root.overview-show-ladders ? "Show ladders ✓" : "Show ladders";
                            clicked => { root.toggle-overview-ladders(); }
                        }
                        Text {
                            text: root.overview-gel
                                ? "click a lane to open it in Detail"
                                : "click a trace to open it in Detail";
                            color: #555555;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle {} // spacer
                    }
                    overview-scroll := ScrollView {
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        viewport-width: self.visible-width;
                        viewport-height: overview-frame.height;
                        overview-frame := Rectangle {
                            width: overview-scroll.visible-width;
                            height: overview-scroll.visible-width * root.overview-image-height / root.overview-image-width;
                            border-width: 1px;
                            border-color: #cccccc;
                            border-radius: 4px;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                image-fit: fill;
                                source: root.overview-image;
                            }
                            TouchArea {
                                clicked => {
                                    root.overview-click(
                                        self.mouse-x / self.width,
                                        self.mouse-y / self.height);
                                }
                            }
                        }
                    }
                }
            }

        }
    }
}
